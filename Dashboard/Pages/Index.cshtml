@page
@model TestOPCUA_WebApp.Pages.IndexModel
@{
    ViewData["Title"] = "Testserver verwalten";
}

@if (!string.IsNullOrWhiteSpace(Model.Message))
{
    <div class="notice @(Model.IsError ? "notice-error" : "notice-success")" role="alert">
        <span class="notice-marker" aria-hidden="true"></span>
        <p>@Model.Message</p>
    </div>
}

<div class="overview-grid">
    <section class="panel" id="server-konfiguration" aria-labelledby="config-title">
        <div class="panel-heading">
            <div>
                <span class="eyebrow">01 / VERBINDUNG</span>
                <h2 id="config-title">Serverkonfiguration</h2>
            </div>
        </div>
        <p class="panel-description">Trage den Namen und die Adresse der zugehörigen API ein. Die Verbindung wird vor dem Speichern geprüft.</p>
        <form method="post" asp-page-handler="SaveServer" class="form-stack">
            <div class="form-field">
                <label asp-for="Server.Name">Servername</label>
                <input asp-for="Server.Name" placeholder="z. B. PLC1" required />
            </div>
            <div class="form-field">
                <label asp-for="Server.ApiAddress">API-Adresse</label>
                <input asp-for="Server.ApiAddress" placeholder="http://localhost:6084" required />
            </div>
            <button type="submit" class="button button-primary">Server speichern <span aria-hidden="true">→</span></button>
        </form>
    </section>

    <section class="panel" id="gespeicherte-server" aria-labelledby="servers-title">
        <div class="panel-heading">
            <div>
                <span class="eyebrow">02 / ÜBERSICHT</span>
                <h2 id="servers-title">Gespeicherte Testserver</h2>
            </div>
            <div class="panel-heading-actions">
                <a asp-page="/Index" class="status-refresh">Status aktualisieren</a>
                <span class="count-badge">@Model.Servers.Count</span>
            </div>
        </div>
        @if (Model.Servers.Count == 0)
        {
            <div class="empty-state">
                <span class="empty-state-icon" aria-hidden="true">+</span>
                <p>Noch keine Testserver gespeichert.</p>
                <small>Lege links deinen ersten Server an.</small>
            </div>
        }
        else
        {
            <div class="server-list">
                @foreach (var server in Model.Servers)
                {
                    string status = Model.ConnectionStatuses.GetValueOrDefault(server.Name, "Unbekannt");
                    string statusClass = status == "Connected" ? "status-connected" :
                        status == "Disconnected" ? "status-disconnected" : "status-unknown";

                    <div class="server-card">
                        <div class="server-icon" aria-hidden="true">@server.Name.Substring(0, 1).ToUpperInvariant()</div>
                        <div class="server-details">
                            <h3>@server.Name</h3>
                            <span class="connection-status @statusClass"><span aria-hidden="true"></span>@status</span>
                            <p>@server.ApiAddress</p>
                        </div>
                        <form method="post" asp-page-handler="DeleteServer">
                            <input type="hidden" name="name" value="@server.Name" />
                            <button type="submit" class="button button-text-danger" aria-label="@server.Name löschen">Löschen</button>
                        </form>
                    </div>
                }
            </div>
        }
    </section>
</div>

<section class="panel panel-write" id="node-schreiben" aria-labelledby="write-title">
    <div class="panel-heading">
        <div>
            <span class="eyebrow">03 / SCHREIBEN</span>
            <h2 id="write-title">Node-Wert schreiben</h2>
        </div>
        <span class="write-label">TESTSERVER</span>
    </div>
    <p class="panel-description">Beim Schreiben wird der ausgewählte Simulator auf Manual gestellt. Angezeigt werden seine beschreibbaren Nodes.</p>
    <form method="post" asp-page-handler="SetMode" class="mode-form">
        <input type="hidden" asp-for="ModeServerName" />
        <div class="form-field">
            <label asp-for="ServerMode">Modus für <span id="ModeServerLabel">den ausgewählten Server</span></label>
            <select asp-for="ServerMode">
                <option value="Static">Static – Werte unverändert lassen</option>
                <option value="Manual">Manual – Werte manuell setzen</option>
                <option value="Cyclic">Cyclic – zyklische Simulation</option>
                <option value="Scenario">Scenario – YAML-Szenario abspielen</option>
            </select>
            <small id="CurrentServerMode" class="node-search-status"></small>
        </div>
        <div class="form-field" id="ScenarioPathField" hidden>
            <label asp-for="ScenarioPath">Szenariodatei auf dem Server (optional)</label>
            <input asp-for="ScenarioPath" placeholder="Leer lassen für das konfigurierte Standardszenario" />
        </div>
        <button type="submit" id="ApplyServerMode" class="button button-primary">Modus übernehmen</button>
    </form>
    <form method="post" asp-page-handler="WriteValue" class="write-form">
        <div class="form-field">
            <label asp-for="WriteServerName">Testserver</label>
            <select asp-for="WriteServerName" required>
                <option value="">Server auswählen</option>
                @foreach (var server in Model.Servers)
                {
                    <option value="@server.Name" data-mode="@Model.ModesByServer.GetValueOrDefault(server.Name)">@server.Name</option>
                }
            </select>
        </div>
        <div class="form-field node-field">
            <label asp-for="NodeId">Node auswählen</label>
            <select asp-for="NodeId" required aria-describedby="NodeSearchStatus">
                <option value="">Node auswählen</option>
                @foreach (var serverNodes in Model.NodesByServer)
                {
                    foreach (string nodeId in serverNodes.Value)
                    {
                        <option value="@nodeId" data-server="@serverNodes.Key">@nodeId</option>
                    }
                }
            </select>
            <label for="NodeSearch" class="node-result-label">Suche (optional)</label>
            <div class="node-search-tools">
                <input id="NodeSearch" type="search" placeholder="Liste filtern, z. B. Status oder DB1000"
                       autocomplete="off" aria-controls="NodeId" aria-describedby="NodeSearchStatus" />
                <button type="button" id="NodeSearchClear" class="button button-primary">Alle Nodes anzeigen</button>
            </div>
            <small id="NodeSearchStatus" class="node-search-status" role="status" aria-live="polite"></small>
        </div>
        <div class="form-field">
            <label asp-for="DataType">Datentyp</label>
            <select asp-for="DataType" required>
                <option value="">Datentyp auswählen</option>
                <option value="Boolean">Boolean</option>
                <option value="Byte">USInt (Byte)</option>
                <option value="Int16">Int16</option>
                <option value="Int32">Int32</option>
                <option value="UInt16">UInt16</option>
                <option value="UInt32">UInt32</option>
                <option value="Float">Float</option>
                <option value="Double">Double</option>
                <option value="String">String</option>
            </select>
        </div>
        <div class="form-field">
            <label asp-for="Value">Neuer Wert</label>
            <input asp-for="Value" placeholder="true, 42 oder Text" required />
        </div>
        <div class="write-actions">
            <button type="submit" class="button button-primary">Wert schreiben <span aria-hidden="true">→</span></button>
        </div>
    </form>
</section>




