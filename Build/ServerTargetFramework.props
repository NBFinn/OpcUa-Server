<Project>
  <PropertyGroup>
    <Configurations>Debug;Release;Debug-Net6;Debug-Net7;Debug-Net8;Debug-Net9;Debug-Net10</Configurations>
    <!-- Explicit framework choices remain available; ordinary Debug/Release select automatically. -->
    <ServerTargetFramework Condition="'$(ServerTargetFramework)' == '' and '$(Configuration)' == 'Debug-Net6'">net6.0</ServerTargetFramework>
    <ServerTargetFramework Condition="'$(ServerTargetFramework)' == '' and '$(Configuration)' == 'Debug-Net7'">net7.0</ServerTargetFramework>
    <ServerTargetFramework Condition="'$(ServerTargetFramework)' == '' and '$(Configuration)' == 'Debug-Net8'">net8.0</ServerTargetFramework>
    <ServerTargetFramework Condition="'$(ServerTargetFramework)' == '' and '$(Configuration)' == 'Debug-Net9'">net9.0</ServerTargetFramework>
    <ServerTargetFramework Condition="'$(ServerTargetFramework)' == '' and '$(Configuration)' == 'Debug-Net10'">net10.0</ServerTargetFramework>

    <!-- The SDK provides its runtime. Select its major version within the tested .NET 8-10 range. -->
    <_ServerSdkMajor>$([System.Text.RegularExpressions.Regex]::Match('$(NETCoreSdkVersion)', '^[0-9]+').Value)</_ServerSdkMajor>
    <_ServerAutomaticMajor>8</_ServerAutomaticMajor>
    <_ServerAutomaticMajor Condition="'$(_ServerSdkMajor)' != '' and $(_ServerSdkMajor) &gt;= 9">9</_ServerAutomaticMajor>
    <_ServerAutomaticMajor Condition="'$(_ServerSdkMajor)' != '' and $(_ServerSdkMajor) &gt;= 10">10</_ServerAutomaticMajor>

    <!-- Visual Studio 2022 supports net8 from 17.8 and net9 from 17.12, even with a newer SDK. -->
    <_ServerInVs2022 Condition="'$(BuildingInsideVisualStudio)' == 'true' and '$(VisualStudioVersion)' != '' and $([MSBuild]::VersionLessThan('$(VisualStudioVersion)', '18.0'))">true</_ServerInVs2022>
    <_ServerAutomaticMajor Condition="'$(_ServerInVs2022)' == 'true' and $(_ServerAutomaticMajor) &gt; 9">9</_ServerAutomaticMajor>
    <_ServerAutomaticMajor Condition="'$(_ServerInVs2022)' == 'true' and $([MSBuild]::VersionLessThan('$(MSBuildVersion)', '17.12')) and $(_ServerAutomaticMajor) &gt; 8">8</_ServerAutomaticMajor>
    <ServerTargetFramework Condition="'$(ServerTargetFramework)' == ''">net$(_ServerAutomaticMajor).0</ServerTargetFramework>

    <DebugSymbols Condition="$(Configuration.StartsWith('Debug-Net'))">true</DebugSymbols>
    <DebugType Condition="$(Configuration.StartsWith('Debug-Net'))">portable</DebugType>
    <Optimize Condition="$(Configuration.StartsWith('Debug-Net'))">false</Optimize>
    <DefineConstants Condition="$(Configuration.StartsWith('Debug-Net'))">$(DefineConstants);DEBUG;TRACE</DefineConstants>
  </PropertyGroup>
  <Target Name="CheckAutomaticFrameworkToolchain" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(_ServerSdkMajor)' != '' and $(_ServerSdkMajor) &lt; 8"
           Text="This project uses C# 12. Install a .NET 8 or newer SDK; .NET 6/7 remain available as runtime targets with that toolchain." />
  </Target>
</Project>
