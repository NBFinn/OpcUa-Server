<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <StartupObject>OpcUA_Server.Program</StartupObject>
    <ServerTargetFramework Condition="'$(ServerTargetFramework)' == ''">net10.0</ServerTargetFramework>
    <TargetFramework>$(ServerTargetFramework)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="OPCFoundation.NetStandard.Opc.Ua" Version="1.5.378.176" />
  </ItemGroup>
  <ItemGroup>
    <None Update="TestServer\OpcUaServers.json" TargetPath="OpcUaServers.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="TestServer\Devices\**\*.json" TargetPath="Devices\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="TestServer\Simulations\Scenarios\*.yaml" TargetPath="Scenarios\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Program.cs;TestServer\**\*.cs" />
    <None Remove="Dashboard\**;AppHost\**" />
  </ItemGroup>
</Project>